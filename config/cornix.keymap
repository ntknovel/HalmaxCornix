/*
 * Cornix ZMK BASIC 260817 FIXED v1.2
 * Converted from the user's RMK/Vial backup: "cornix 260817.vil".
 *
 * 10 user layers + 2 internal mouse-speed layers, 50 positions, two encoders, 31 active combos.
 * Includes BT recovery/output controls and runtime TX 0/+/-/MAX.
 * No Korean chord/abbreviation engine or other custom typing engine is included.
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BASE      0
#define NAV       1
#define MOUSE     2
#define EDIT      3
#define MEDIA_BT  4
#define NUMPAD    5
#define SYMBOL    6
#define FN        7
#define PUNCT     8
#define PLAIN     9
#define MOUSE_ACL2 10
#define MOUSE_ACL0 11

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 37 44 45 46 47 48 49>;
            hold-trigger-on-release;
            display-name = "HRM Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40 41 42 43>;
            hold-trigger-on-release;
            display-name = "HRM Right";
        };

        th150: tap_hold_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            display-name = "Tap-Hold 150";
        };

        th200: tap_hold_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            display-name = "Tap-Hold 200";
        };

        th250: tap_hold_250 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            display-name = "Tap-Hold 250";
        };

        lt60: layer_tap_60 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <60>;
            display-name = "Layer-Tap 60";
        };

        lt80: layer_tap_80 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <80>;
            display-name = "Layer-Tap 80";
        };

        lt120: layer_tap_120 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            display-name = "Layer-Tap 120";
        };

        /*
         * Vial LT4(Esc) and LT7(Delete) used Permissive Hold + Chordal Hold.
         * Keep fast same-hand rolls as taps, while opposite-hand chords turn
         * into the held layer as soon as the trigger key is released.
         */
        ltl200: layer_tap_left_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 37 44 45 46 47 48 49>;
            hold-trigger-on-release;
            display-name = "Layer-Tap Left 200";
        };

        ltr200: layer_tap_right_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40 41 42 43>;
            hold-trigger-on-release;
            display-name = "Layer-Tap Right 200";
        };

        lt250: layer_tap_250 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            display-name = "Layer-Tap 250";
        };


        /* Runtime BLE transmit-output controls. RX sensitivity is unchanged. */
        rf0: rf0 {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <1>;
            display-name = "TX 0 dBm";
        };

        rfu: rfu {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <2>;
            display-name = "TX Power +";
        };

        rfd: rfd {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <0>;
            display-name = "TX Power -";
        };

        rfm: rfm {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <3>;
            display-name = "TX MAX +8";
        };

        encscr: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };


        /*
         * QMK/Vial KC_ACL0 and KC_ACL2 equivalents.
         *
         * Normal &mmv keeps ZMK's 300 ms acceleration curve. While ACL0 or
         * ACL2 is held, a helper layer replaces only the movement/scroll keys
         * with constant-speed behavior instances:
         *   ACL0: cursor 150 (1/4 of ZMK's 600 default), scroll 3
         *   ACL2: cursor 600 (immediate maximum), scroll 10
         */
        m0mv: mouse_move_acl0 {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            trigger-period-ms = <16>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
            display-name = "Mouse ACL0 Slow";
        };

        m2mv: mouse_move_acl2 {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            trigger-period-ms = <16>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
            display-name = "Mouse ACL2 Fast";
        };

        m0sc: mouse_scroll_acl0 {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            trigger-period-ms = <16>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
            display-name = "Scroll ACL0 Slow";
        };

        m2sc: mouse_scroll_acl2 {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            trigger-period-ms = <16>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
            display-name = "Scroll ACL2 Fast";
        };
    };

    m0mv_input_listener: m0mv_input_listener {
        compatible = "zmk,input-listener";
        device = <&m0mv>;
    };

    m2mv_input_listener: m2mv_input_listener {
        compatible = "zmk,input-listener";
        device = <&m2mv>;
    };

    m0sc_input_listener: m0sc_input_listener {
        compatible = "zmk,input-listener";
        device = <&m0sc>;
    };

    m2sc_input_listener: m2sc_input_listener {
        compatible = "zmk,input-listener";
        device = <&m2sc>;
    };

    combos {
        compatible = "zmk,combos";
        combo_00 {
            timeout-ms = <40>;
            key-positions = <3 4>;
            bindings = <&kp LG(SPACE)>;
            layers = <BASE>;
        };
        combo_01 {
            timeout-ms = <40>;
            key-positions = <3 2>;
            bindings = <&kp LANG2>;
            layers = <BASE>;
        };
        combo_02 {
            timeout-ms = <40>;
            key-positions = <8 9>;
            bindings = <&kp LANG1>;
            layers = <BASE>;
        };
        combo_03 {
            timeout-ms = <40>;
            key-positions = <7 8>;
            bindings = <&kp F2>;
            layers = <BASE>;
        };
        combo_04 {
            timeout-ms = <40>;
            key-positions = <34 33>;
            bindings = <&kp EQUAL>;
            layers = <BASE PLAIN>;
        };
        combo_05 {
            timeout-ms = <40>;
            key-positions = <16 17>;
            bindings = <&kp LPAR>;
            layers = <BASE>;
        };
        combo_06 {
            timeout-ms = <40>;
            key-positions = <34 35>;
            bindings = <&kp SEMI>;
            layers = <BASE NUMPAD>;
        };
        combo_07 {
            timeout-ms = <40>;
            key-positions = <4 5>;
            bindings = <&kp LBRC>;
            layers = <BASE PLAIN>;
        };
        combo_08 {
            timeout-ms = <40>;
            key-positions = <25 26>;
            bindings = <&kp LC(X)>;
            layers = <BASE PLAIN>;
        };
        combo_09 {
            timeout-ms = <40>;
            key-positions = <21 22>;
            bindings = <&kp SQT>;
            layers = <BASE>;
        };
        combo_10 {
            timeout-ms = <40>;
            key-positions = <19 18>;
            bindings = <&kp RPAR>;
            layers = <BASE>;
        };
        combo_11 {
            timeout-ms = <40>;
            key-positions = <29 28>;
            bindings = <&kp LBKT>;
            layers = <BASE PLAIN>;
        };
        combo_12 {
            timeout-ms = <40>;
            key-positions = <32 33>;
            bindings = <&kp RBKT>;
            layers = <BASE PLAIN>;
        };
        combo_13 {
            timeout-ms = <40>;
            key-positions = <26 28>;
            bindings = <&kp LC(LS(V))>;
            layers = <BASE PLAIN>;
        };
        combo_14 {
            timeout-ms = <40>;
            key-positions = <6 7>;
            bindings = <&kp RBRC>;
            layers = <BASE PLAIN>;
        };
        combo_15 {
            timeout-ms = <40>;
            key-positions = <36 35>;
            bindings = <&kp EXCL>;
            layers = <BASE NUMPAD>;
        };
        combo_16 {
            timeout-ms = <40>;
            key-positions = <26 27>;
            bindings = <&kp LC(C)>;
            layers = <BASE PLAIN>;
        };
        combo_17 {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&kp LC(V)>;
            layers = <BASE PLAIN>;
        };
        combo_19 {
            timeout-ms = <40>;
            key-positions = <7 9>;
            bindings = <&caps_word>;
            layers = <BASE PLAIN>;
        };
        combo_20 {
            timeout-ms = <40>;
            key-positions = <1 13>;
            bindings = <&kp N1>;
            layers = <BASE PLAIN>;
        };
        combo_21 {
            timeout-ms = <40>;
            key-positions = <2 14>;
            bindings = <&kp N2>;
            layers = <BASE>;
        };
        combo_22 {
            timeout-ms = <40>;
            key-positions = <3 15>;
            bindings = <&kp N3>;
            layers = <BASE>;
        };
        combo_23 {
            timeout-ms = <40>;
            key-positions = <4 16>;
            bindings = <&kp N4>;
            layers = <BASE>;
        };
        combo_24 {
            timeout-ms = <40>;
            key-positions = <5 17>;
            bindings = <&kp N5>;
            layers = <BASE>;
        };
        combo_25 {
            timeout-ms = <40>;
            key-positions = <6 18>;
            bindings = <&kp N6>;
            layers = <BASE>;
        };
        combo_26 {
            timeout-ms = <40>;
            key-positions = <7 19>;
            bindings = <&kp N7>;
            layers = <BASE>;
        };
        combo_27 {
            timeout-ms = <40>;
            key-positions = <8 20>;
            bindings = <&kp N8>;
            layers = <BASE>;
        };
        combo_28 {
            timeout-ms = <40>;
            key-positions = <9 21>;
            bindings = <&kp N9>;
            layers = <BASE>;
        };
        combo_29 {
            timeout-ms = <40>;
            key-positions = <10 22>;
            bindings = <&kp N0>;
            layers = <BASE>;
        };
        combo_30 {
            timeout-ms = <40>;
            key-positions = <17 18 4 7>;
            bindings = <&to BASE>;
            layers = <PLAIN>;
        };
        combo_31 {
            timeout-ms = <40>;
            key-positions = <17 18 4 7>;
            bindings = <&to PLAIN>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Base";
            bindings = <
                &th150 TILDE GRAVE  &kp Q  &kp W  &lt250 PUNCT E  &kp R  &kp T  &kp Y  &kp U  &lt250 PUNCT I  &kp O  &kp P  &kp BSPC
                &sk LSHIFT  &kp A  &hml LALT S  &hml LCTRL D  &hml LSHIFT F  &hml LGUI G  &hmr RGUI H  &hmr RSHIFT J  &hmr LCTRL K  &hmr RALT L  &th250 PLUS MINUS  &lt80 PUNCT RET
                &mo PUNCT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE  &mkp MB3  &kp N  &kp M  &kp COMMA  &th200 FSLH DOT  &kp UP  &sk RSHIFT
                &kp CAPSLOCK  &none  &none  &ltl200 MEDIA_BT ESC  &lt120 MOUSE TAB  &lt60 NAV SPACE  &lt60 NUMPAD SPACE  &kp BSPC  &ltr200 FN DEL  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
                &none  &none  &none  &none  &none  &none  &kp KP_NUM  &kp PG_UP  &kp UP  &kp PG_DN  &none  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END  &kp RET
                &none  &none  &none  &none  &none  &none  &kp C_MUTE  &mkp MB3  &none  &kp HOME  &none  &kp END  &kp HOME  &none
                &none  &none  &none  &none  &none  &none  &kp SPACE  &kp BSPC  &kp DEL  &kp PG_UP  &kp END  &kp PG_DN
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &msc SCRL_UP  &mmv MOVE_UP  &msc SCRL_DOWN  &none  &none
                &none  &mo MOUSE_ACL0  &mo MOUSE_ACL2  &mkp MB2  &mkp MB1  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &kp C_MUTE  &mkp MB3  &none  &msc SCRL_LEFT  &mkp MB3  &msc SCRL_RIGHT  &msc SCRL_LEFT  &none
                &none  &none  &none  &none  &none  &none  &mkp MB1  &mkp MB2  &mkp MB3  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        edit_layer {
            display-name = "Editing";
            bindings = <
                &none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &none  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &kp C_MUTE  &mkp MB3  &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
                &none  &none  &none  &mkp MB3  &mkp MB2  &mkp MB1  &mkp MB1  &mkp MB2  &mkp MB3  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        media_bt_layer {
            display-name = "Media-BT";
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &kp C_MUTE  &kp C_STOP  &kp C_PLAY_PAUSE  &none  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &none  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
                &bt BT_CLR  &bt BT_CLR_ALL  &out OUT_BLE  &out OUT_USB  &mo EDIT  &mo SYMBOL  &kp C_MUTE  &mkp MB3  &bt BT_NXT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none
                &rf0  &rfu  &rfd  &none  &rfm  &none  &none  &none  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
                &trans  &kp FSLH  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp ASTERISK  &none  &kp PG_UP  &kp UP  &kp PG_DN  &none  &trans
                &trans  &kp MINUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp PLUS  &kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END  &trans
                &trans  &kp PRCNT  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp EQUAL  &kp C_MUTE  &mkp MB3  &none  &none  &trans  &trans  &trans  &trans
                &none  &none  &none  &none  &kp CARET  &kp KP_N0  &none  &none  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        symbol_layer {
            display-name = "Symbols";
            bindings = <
                &none  &kp LBRC  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RBRC  &none  &none  &none  &none  &none  &none
                &none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &none  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &kp DQT  &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp PIPE  &kp C_MUTE  &mkp MB3  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &kp LPAR  &kp RPAR  &kp UNDER  &none  &none  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        fn_layer {
            display-name = "Function";
            bindings = <
                &none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN  &none  &none  &none  &none  &none  &none
                &none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK  &none  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
                &none  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &kp C_MUTE  &mkp MB3  &none  &none  &none  &none  &kp HOME  &none
                &none  &none  &none  &kp K_APP  &kp SPACE  &kp TAB  &none  &none  &none  &kp PG_UP  &kp END  &kp PG_DN
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        punct_layer {
            display-name = "Punctuation";
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR  &th150 UNDER MINUS
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &none  &kp LPAR  &kp RPAR  &th150 PLUS EQUAL  &th150 COLON SEMI  &th150 DQT SQT
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &th150 LBRC LBKT  &th150 RBRC RBKT  &th150 PIPE BSLH  &kp KP_ASTERISK  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &kp EQUAL  &th150 UNDER MINUS  &kp KP_SLASH  &kp KP_PLUS
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        plain_layer {
            display-name = "Plain";
            bindings = <
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp MINUS  &kp RET
                &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE  &mkp MB3  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP  &kp RSHIFT
                &kp LCTRL  &kp LGUI  &kp LALT  &kp ESC  &kp TAB  &kp SPACE  &kp SPACE  &kp BSPC  &kp DEL  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };


        /* Internal helper layer for momentary KC_ACL2-equivalent maximum speed. */
        mouse_acl2_layer {
            display-name = "Mouse ACL2 Fast";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m2sc MOVE_Y(10)  &m2mv MOVE_Y(-600)  &m2sc MOVE_Y(-10)  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m2mv MOVE_X(-600)  &m2mv MOVE_Y(600)  &m2mv MOVE_X(600)  &m2sc MOVE_X(10)  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m2sc MOVE_X(-10)  &trans  &m2sc MOVE_X(10)  &m2sc MOVE_X(-10)  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };

        /* Internal helper layer for momentary KC_ACL0-equivalent precision speed. */
        mouse_acl0_layer {
            display-name = "Mouse ACL0 Slow";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m0sc MOVE_Y(3)  &m0mv MOVE_Y(-150)  &m0sc MOVE_Y(-3)  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m0mv MOVE_X(-150)  &m0mv MOVE_Y(150)  &m0mv MOVE_X(150)  &m0sc MOVE_X(3)  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m0sc MOVE_X(-3)  &trans  &m0sc MOVE_X(3)  &m0sc MOVE_X(-3)  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &encscr>;
        };
    };
};
