/* CCK BALL 4x6 MODU STENO v1.1.1. RIGHT is central. */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/cornix_steno.h>
#define BASE 0
#define FN 1
#define BT 2
#define SCROLL 3
#define SNIPE 4
#define STENO 5
#define SELECT_NAV 6
#define SYMBOL 7
#include "cck-steno.dtsi"
#include "cck-steno-aux.dtsi"

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        /* STENO Tab location: short solo ~, 200ms hold Tab.
         * A Ctrl/Alt/LGUI already held bypasses the ~ branch and keeps mods.
         * Both branches use the original auxiliary FIFO/selector handling. */
        cck_tab_ht: cck_tab_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&cck_tab_hold>, <&cck_tab_tap>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            display-name = "CCK Tab hold / Tilde tap 200ms";
        };
        cck_tab: cck_tab_mod_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&cck_tab_ht 0 0>, <&cck_tab_hold>;
            mods = <(MOD_LCTL | MOD_RCTL | MOD_LALT | MOD_RALT | MOD_LGUI)>;
            keep-mods = <(MOD_LCTL | MOD_RCTL | MOD_LALT | MOD_RALT | MOD_LGUI)>;
            display-name = "CCK ~ tap / Tab hold and modifier Tab";
        };
        cck_wheel: cck_wheel {
            compatible = "zmk,behavior-cck-wheel";
            #binding-cells = <1>;
            display-name = "CCK Internal wheel routing - do not assign";
        };
        st_sel: steno_select_shift_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&select_shift>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            display-name = "ST Select Shift / RAlt tap 500ms";
        };
    };
    wheel_left: wheel_left {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&cck_wheel 60>, <&cck_wheel 61>;
        tap-ms = <10>;
    };
    wheel_right: wheel_right {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&cck_wheel 62>, <&cck_wheel 63>;
        tap-ms = <10>;
    };
    macros {
        select_shift: select_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>; tap-ms = <0>;
            bindings = <&macro_press &mo SELECT_NAV &kp RSHIFT>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo SELECT_NAV &kp RSHIFT>;
        };
/* BEGIN CORNIX QUICK MACROS (generated from config/steno_quick_text.tsv) */
        /*
         * Standard ZMK macros visible in the Keymap Editor Macros panel.
         * Fixed STENO input masks are dispatched to stable M0..M11 nodes.
         * Edit the bindings in the GUI, or edit steno_quick_text.tsv and rerun
         * tools/update_quick_macro_text.py.
         */
        /* M0: 약어L+ㅡ -> 사구구 */
        quick_0: quick_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M0 Quick L+EU";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp K &kp R &kp N &kp R &kp N>;
        };

        /* M1: 약어L+ㅗ -> 구서룡 */
        quick_1: quick_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M1 Quick L+O";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp R &kp N &kp T &kp J &kp F &kp Y &kp D>;
        };

        /* M2: 약어L+ㅜ -> 피피쿵 */
        quick_2: quick_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M2 Quick L+U";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp V &kp L &kp V &kp L &kp Z &kp N &kp D>;
        };

        /* M3: 약어R+ㅏ -> 스타라이트 */
        quick_3: quick_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M3 Quick R+A";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp M &kp X &kp K &kp F &kp K &kp D &kp L &kp X &kp M>;
        };

        /* M4: 약어R+ㅣ -> 유안나 */
        quick_4: quick_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M4 Quick R+I";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp B &kp D &kp K &kp S &kp S &kp K>;
        };

        /* M5: 약어R+ㅓ -> 유혜나 */
        quick_5: quick_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M5 Quick R+EO";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp B &kp G &kp LS(P) &kp S &kp K>;
        };

        /* M6: 약어L+ㅏ -> 실험체 */
        quick_6: quick_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M6 Quick L+A";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp L &kp F &kp G &kp J &kp A &kp C &kp P>;
        };

        /* M7: 약어L+ㅓ -> A 시 */
        quick_7: quick_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M7 Quick L+EO";
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp RALT &kp LS(A) &kp SPACE &kp RALT &kp T &kp L>;
        };

        /* M8: 약어L+ㅣ -> W 시 */
        quick_8: quick_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M8 Quick L+I";
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp RALT &kp LS(W) &kp SPACE &kp RALT &kp T &kp L>;
        };

        /* M9: 약어R+ㅗ -> 케이지 */
        quick_9: quick_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M9 Quick R+O";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp Z &kp P &kp D &kp L &kp W &kp L>;
        };

        /* M10: 약어R+ㅜ -> 일렉트리스 */
        quick_10: quick_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M10 Quick R+U";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp L &kp F &kp F &kp P &kp R &kp X &kp M &kp F &kp L &kp T &kp M>;
        };

        /* M11: 약어R+ㅡ -> 마이스터 */
        quick_11: quick_11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M11 Quick R+EU";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp A &kp K &kp D &kp L &kp T &kp M &kp X &kp J>;
        };
        /* END CORNIX QUICK MACROS */
    };
    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            display-name = "Base";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BACKSPACE // 00..11
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &st_mode // 12..23
                &kp CAPSLOCK  &kp A  &kp S  &kp D  &lt 3 F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT // 24..35
                &kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP_ARROW  &kp FSLH // 36..47
                &kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp DELETE  &kp SPACE  &mo 1  &mo 2  &kp SPACE  &kp ENTER  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_1 {
            display-name = "Fn";
            bindings = <
                &kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11 // 00..11
                &kp A  &mo SNIPE  &mo SYMBOL  &none  &none  &trans  &none  &none  &none  &trans  &trans  &kp BSLH // 12..23
                &trans  &none  &none  &none  &none  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans // 24..35
                &trans  &trans  &trans  &trans  &trans  &none  &none  &none  &trans  &trans  &none  &trans // 36..47
                &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_2 {
            display-name = "Bluetooth";
            bindings = <
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &out OUT_BLE  &bootloader  &sys_reset  &trans  &kp W // 00..11
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 12..23
                &trans  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 24..35
                &trans  &trans  &trans  &bt BT_CLR  &trans  &trans  &bt BT_NXT  &trans  &trans  &trans  &trans  &trans // 36..47
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_3 {
            display-name = "Scroll";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 00..11
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 12..23
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 24..35
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 36..47
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_4 {
            display-name = "Snipe";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 00..11
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 12..23
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 24..35
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 36..47
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_5 {
            display-name = "STENO";
            bindings = <
                &mxesc  &mx1  &mx2  &mx3  &mx4  &mx5  &mx6  &mx7  &mx8  &mx9  &mx0  &mxbsp // 00..11
                &cck_tab  &st_i_b  &st_i_j  &st_i_d  &st_i_g  &st_i_s  &st_f_s  &st_f_g  &st_f_d  &st_f_j  &st_f_b  &st_mode // 12..23
                &st_abbr_l  &st_i_m  &st_i_n  &st_i_ng  &st_i_r  &st_i_h  &st_f_h  &st_f_r  &st_f_ng  &st_f_n  &st_f_m  &st_abbr_r // 24..35
                &st_vext_l  &st_i_kh  &st_i_t  &st_i_ch  &st_i_p  &st_i_double  &st_f_double  &st_f_p  &st_f_ch  &st_f_t  &st_f_kh  &st_vext_r // 36..47
                &kp LCTRL  &kp LALT  &st_symbol_l  &st_v_o  &st_v_eu  &st_vu_enter  &st_veo_space  &st_v_i  &st_v_a  &st_symbol_r  &st_sel 0 RALT  &kp BSPC // 48..59
                &st_arrow UP  &st_arrow DOWN  &st_arrow LEFT  &st_arrow RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_6 {
            display-name = "Select";
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none // 00..11
                &none  &none  &none  &none  &none  &none  &none  &none  &kp UP  &none  &none  &st_mode // 12..23
                &none  &none  &none  &none  &none  &none  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none // 24..35
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none // 36..47
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
        layer_7 {
            display-name = "Symbols";
            bindings = <
                &kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR  &kp BSPC // 00..11
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 12..23
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 24..35
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 36..47
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans // 48..59
                &kp UP  &kp DOWN  &kp LEFT  &kp RIGHT // 60..63: L CW / L CCW / R CW / R CCW
            >;
            sensor-bindings = <&wheel_left &wheel_right>;
        };
    };
};
