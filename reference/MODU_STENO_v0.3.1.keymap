/* SPDX-License-Identifier: LicenseRef-EKS-NonCommercial-1.0
 * MODIFIED v0.3.0: user's Cornix v2.2.6 STENO and Base mapping on MODU Compact71.
 * Board, scan, split and trackball hardware remain in the pinned MODU modules.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/cornix_steno.h>
#include "modu-controls.dtsi"
#include "generated/modu-hardware.dtsi"
#define BASE 0
#define NUM 1
#define MODU_CONTROLS 2
#define MOUSE 3
#define NAV 4
#define FN 5
#define SYMBOL 6
#define STENO 7
#define SELECT_NAV 8
#include "modu-steno.dtsi"
#include "modu-steno-aux.dtsi"

/ {
    behaviors {
        /*
         * QMK/Vial layer-tap approximation:
         * - Tapping Term: 250 ms
         * - Flow Tap: 120 ms (require-prior-idle-ms)
         * - balanced flavor keeps quick layer chords usable.
         *
         * Vial's Chordal Hold cannot be copied bit-for-bit without a
         * hand/position policy, so this is the closest safe general behavior.
         */
        lt250: layer_tap_250 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            require-prior-idle-ms = <120>;
            display-name = "Layer-Tap 250ms";
        };

        /* Vial tap-dance entries used by this keymap: tap key / hold key. */
        ht300: hold_tap_300 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            display-name = "Tap-Hold 300ms";
        };

        ht200: hold_tap_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            display-name = "Tap-Hold 200ms";
        };

        ht150: hold_tap_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            display-name = "Tap-Hold 150ms";
        };


        lang_ht: lang_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&st_lang_return>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            display-name = "Hangul tap / RCtrl hold";
        };

    };
    macros {
        /*
         * Cornix STENO selection key: hold real RShift and temporarily
         * replace physical J/L/K/I with Left/Right/Down/Up.
         */
        select_shift: select_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo SELECT_NAV &kp RSHIFT>
                , <&macro_pause_for_release>
                , <&macro_release &mo SELECT_NAV &kp RSHIFT>
                ;
        };


        /* BEGIN CORNIX QUICK MACROS (generated from config/steno_quick_text.tsv) */
        /*
         * Standard ZMK macros visible in the Keymap Editor Macros panel.
         * Fixed STENO input masks are dispatched to stable M0..M11 nodes.
         * Edit the bindings in the GUI, or edit steno_quick_text.tsv and rerun
         * tools/update_quick_macro_text.py.
         */
        /* M0: 약어L+ㅡ -> 사구구 */
        quick_0: quick_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M0 Quick L+EU";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp K &kp R &kp N &kp R &kp N>;
        };

        /* M1: 약어L+ㅗ -> 구서룡 */
        quick_1: quick_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M1 Quick L+O";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp R &kp N &kp T &kp J &kp F &kp Y &kp D>;
        };

        /* M2: 약어L+ㅜ -> 피피쿵 */
        quick_2: quick_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M2 Quick L+U";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp V &kp L &kp V &kp L &kp Z &kp N &kp D>;
        };

        /* M3: 약어R+ㅏ -> 스타라이트 */
        quick_3: quick_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M3 Quick R+A";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp M &kp X &kp K &kp F &kp K &kp D &kp L &kp X &kp M>;
        };

        /* M4: 약어R+ㅣ -> 유안나 */
        quick_4: quick_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M4 Quick R+I";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp B &kp D &kp K &kp S &kp S &kp K>;
        };

        /* M5: 약어R+ㅓ -> 유혜나 */
        quick_5: quick_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M5 Quick R+EO";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp B &kp G &kp LS(P) &kp S &kp K>;
        };

        /* M6: 약어L+ㅏ -> 실험체 */
        quick_6: quick_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M6 Quick L+A";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp L &kp F &kp G &kp J &kp A &kp C &kp P>;
        };

        /* M7: 약어L+ㅓ -> A 시 */
        quick_7: quick_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M7 Quick L+EO";
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp RALT &kp LS(A) &kp SPACE &kp RALT &kp T &kp L>;
        };

        /* M8: 약어L+ㅣ -> W 시 */
        quick_8: quick_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M8 Quick L+I";
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp RALT &kp LS(W) &kp SPACE &kp RALT &kp T &kp L>;
        };

        /* M9: 약어R+ㅗ -> 케이지 */
        quick_9: quick_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M9 Quick R+O";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp Z &kp P &kp D &kp L &kp W &kp L>;
        };

        /* M10: 약어R+ㅜ -> 일렉트리스 */
        quick_10: quick_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M10 Quick R+U";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp L &kp F &kp F &kp P &kp R &kp X &kp M &kp F &kp L &kp T &kp M>;
        };

        /* M11: 약어R+ㅡ -> 마이스터 */
        quick_11: quick_11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M11 Quick R+EU";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp A &kp K &kp D &kp L &kp T &kp M &kp X &kp J>;
        };
        /* END CORNIX QUICK MACROS */
    
    };
    combos {
        compatible = "zmk,combos";

        combo_grave {
            timeout-ms = <50>;
            key-positions = <12 24>;
            bindings = <&kp GRAVE>;
            layers = <BASE>;
        };
        combo_num_1 {
            timeout-ms = <50>;
            key-positions = <13 25>;
            bindings = <&kp N1>;
            layers = <BASE>;
        };
        combo_num_2 {
            timeout-ms = <50>;
            key-positions = <14 26>;
            bindings = <&kp N2>;
            layers = <BASE>;
        };
        combo_num_3 {
            timeout-ms = <50>;
            key-positions = <15 27>;
            bindings = <&kp N3>;
            layers = <BASE>;
        };
        combo_num_4 {
            timeout-ms = <50>;
            key-positions = <16 28>;
            bindings = <&kp N4>;
            layers = <BASE>;
        };
        combo_num_5 {
            timeout-ms = <50>;
            key-positions = <17 29>;
            bindings = <&kp N5>;
            layers = <BASE>;
        };
        combo_num_6 {
            timeout-ms = <50>;
            key-positions = <18 30>;
            bindings = <&kp N6>;
            layers = <BASE>;
        };
        combo_num_7 {
            timeout-ms = <50>;
            key-positions = <19 31>;
            bindings = <&kp N7>;
            layers = <BASE>;
        };
        combo_num_8 {
            timeout-ms = <50>;
            key-positions = <20 32>;
            bindings = <&kp N8>;
            layers = <BASE>;
        };
        combo_num_9 {
            timeout-ms = <50>;
            key-positions = <21 33>;
            bindings = <&kp N9>;
            layers = <BASE>;
        };
        combo_num_0 {
            timeout-ms = <50>;
            key-positions = <22 34>;
            bindings = <&kp N0>;
            layers = <BASE>;
        };

        /* J+K and D+F momentarily open the Symbols layer. */
        combo_symbol_jk {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mo SYMBOL>;
            layers = <BASE NUM FN>;
            slow-release;
        };
        combo_symbol_df {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&mo SYMBOL>;
            layers = <BASE NUM FN>;
            slow-release;
        };
    
        modu_reset { bindings = <&sys_reset>; key-positions = <48 5 6>; layers = <NUM>; };

    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Base";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LC(A)
                &kp CAPSLOCK &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &ht300 SQT DQT
                &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &ht200 FSLH QUESTION &kp RSHIFT
                &kp LCTRL &kp LALT &ht200 LC(Y) LBKT &ht200 RCTRL RBKT &st_lang_return &kp BSPC
                &lt250 NUM LGUI &lt250 MOUSE MINUS &kp ENTER &kp SPACE &lt250 NAV EQUAL &lt250 FN K_APP &st_mode
                &kp UP &kp DOWN &kp LEFT &kp RIGHT &kp UP &kp DOWN &kp LEFT &kp RIGHT
                &lball MC_MOUSE &rball MC_MOUSE
            >;
        };
        lower_layer {
            display-name = "Num";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp LBKT &kp RBKT &kp DEL
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &mo MODU_CONTROLS &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &st_mode
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        layer_2 {
            display-name = "MODU Controls";
            bindings = <
                &studio_unlock &out OUT_USB &lmode MC_MOUSE &lmode MC_SCROLL &lmode MC_ARROWS &bootloader &bootloader &rmode MC_MOUSE &rmode MC_SCROLL &rmode MC_ARROWS &lmode MC_OFF &rmode MC_OFF
                &lhold MC_MOUSE &lhold MC_SCROLL &lhold MC_ARROWS &lhold MC_OFF &lcpi MC_INC 0 &lcpi MC_DEC 0 &rcpi MC_INC 0 &rcpi MC_DEC 0 &rhold MC_MOUSE &rhold MC_SCROLL &rhold MC_ARROWS &rhold MC_OFF
                &lscroll MC_INC 0 &lscroll MC_DEC 0 &lptr MC_INC 0 &lptr MC_DEC 0 &lrate MC_INC 0 &lrate MC_DEC 0 &rrate MC_INC 0 &rrate MC_DEC 0 &rptr MC_INC 0 &rptr MC_DEC 0 &rscroll MC_INC 0 &rscroll MC_DEC 0
                &ltx MC_INC 0 &ltx MC_DEC 0 &ltx MC_MAX 0 &ltx MC_RESET 0 &lcpi MC_RESET 0 &lreset 0 &rreset 0 &rcpi MC_RESET 0 &rtx MC_INC 0 &rtx MC_DEC 0 &rtx MC_MAX 0 &rtx MC_RESET 0
                &trans &modu_sync 0 &btx MC_RESET 0 &larrow MC_INC 0 &rarrow MC_INC 0 &btx MC_MAX 0
                &lcycle MC_CYCLE_NEXT &trans &trans &trans &rcycle MC_CYCLE_NEXT &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &trans &none &mmv MOVE_UP &none &none &mkp MB4 &mkp MB1 &msc SCRL_UP &mkp MB2 &mkp MB5 &kp DEL
                &trans &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &none &kp SQT
                &trans &none &none &none &none &none &none &none &none &none &kp FSLH &trans
                &kp LCTRL &kp LGUI &kp LALT &trans &ht150 RBKT LBKT &trans
                &trans &trans &trans &trans &trans &trans &st_mode
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        nav_layer {
            display-name = "Nav";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &none &none &kp PG_UP &none &none &none &none &kp UP &kp LBKT &kp RBKT &trans
                &none &none &kp HOME &kp PG_DN &kp END &none &none &kp LEFT &kp DOWN &kp RIGHT &none &kp SQT
                &trans &none &none &none &none &none &none &none &none &none &kp BSLH &trans
                &trans &trans &trans &kp RALT &trans &kp RCTRL
                &trans &trans &trans &trans &trans &trans &st_mode
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        fn_layer {
            display-name = "Fn-BT";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &bt BT_PRV
                &bt BT_SEL 0 &btx MC_SET MC_TX_0 &btx MC_INC 0 &btx MC_DEC 0 &btx MC_MAX 0 &trans &trans &trans &trans &trans &trans &trans
                &bt BT_SEL 1 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &bt BT_SEL 2 &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &st_mode
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        symbol_layer {
            display-name = "Symbols";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTERISK &kp LPAR &kp RPAR &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp SQT
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp QUESTION &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &st_mode
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        steno_layer {
            display-name = "STENO-KO";
            bindings = <
                &mxesc &mx1 &mx2 &mx3 &mx4 &mx5 &mx6 &mx7 &mx8 &mx9 &mx0 &mxbsp
                &mxtab &st_i_b &st_i_j &st_i_d &st_i_g &st_i_s &st_f_s &st_f_g &st_f_d &st_f_j &st_f_b &lang_ht RCTRL 0
                &st_abbr_l &st_i_m &st_i_n &st_i_ng &st_i_r &st_i_h &st_f_h &st_f_r &st_f_ng &st_f_n &st_f_m &st_abbr_r
                &st_vext_l &st_i_kh &st_i_t &st_i_ch &st_i_p &st_i_double &st_f_double &st_f_p &st_f_ch &st_f_t &st_f_kh &st_vext_r
                &kp LCTRL &kp LALT &st_symbol_l &st_symbol_r &select_shift &kp BSPC
                &st_v_o &st_v_eu &st_vu_enter &st_veo_space &st_v_i &st_v_a &st_mode
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };
        select_nav_layer {
            display-name = "Select Nav";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &kp UP &none &none &st_lang_return
                &none &none &none &none &none &none &none &kp LEFT &kp DOWN &kp RIGHT &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none &none &none &st_mode
                &kp UP &kp DOWN &kp LEFT &kp RIGHT &kp UP &kp DOWN &kp LEFT &kp RIGHT
                &trans &trans
            >;
        };
    };
};
#include "local-custom.dtsi"
